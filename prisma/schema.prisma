  @@map("ai_messages")
}

/// Consumption per model call (A2a, especificação §9.3). `keySource`
/// "backup" is the platform courtesy and never counts for the customer.
model AiUsageEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId    String   @map("execution_id") @db.Uuid
  partnerId      String?  @map("partner_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  keySource      String   @map("key_source")
  provider       String
  model          String
  usageKind      String   @default("chat") @map("usage_kind")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  /// A failed call (CF6a): zero tokens and the error code.
  errorCode      String?  @map("error_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("ai_usage_events")
}

/// The partner's vault: the admin key of its Assistant (A2a, §9.1). Only
