  ceiling   Int
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("quota_ceilings")
}

model PlatformLanguage {
  code      String   @id
  name      String
  status    String   @default("draft")
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_languages")
}

/// Edits of the platform over the texts shipped in the code (I1).
model PlatformTranslation {
  locale    String
  key       String
  value     String
  origin    String   @default("manual")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([locale, key])
  @@map("platform_translations")
}

/// Messaging channel of a workspace (A5a, ADR 0011): non-secret settings in
/// `config`, the provider's tokens encrypted in `encryptedSecrets`.
model ChannelConnection {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  kind             String
  name             String
  status           String    @default("active")
  config           Json      @default("{}")
  encryptedSecrets String    @map("encrypted_secrets")
  maskedSecret     String    @map("masked_secret")
  webhookTokenHash String    @unique @map("webhook_token_hash")
  healthStatus     String    @default("unknown") @map("health_status")
  healthError      String?   @map("health_error")
  healthCheckedAt  DateTime? @map("health_checked_at") @db.Timestamptz()
  lastEventAt      DateTime? @map("last_event_at") @db.Timestamptz()
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([id, workspaceId])
  @@map("channel_connections")
}

/// Owner of a (connection, scope): at most one active route (A5a).
model ChannelRoute {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  scope          String
  consumerModule String   @map("consumer_module")
  consumerRef    String   @map("consumer_ref") @db.Uuid
  status         String   @default("active")
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([id, workspaceId])
  @@map("channel_routes")
}

/// A conversation of the provider, per connection (A5a).
model ChannelConversation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  connectionId      String   @map("connection_id") @db.Uuid
  scope             String
  externalId        String   @map("external_id")
  externalContactId String?  @map("external_contact_id")
  externalStatus    String?  @map("external_status")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  lastEventAt       DateTime @default(now()) @map("last_event_at") @db.Timestamptz()

  @@unique([id, workspaceId])
  @@unique([connectionId, externalId])
  @@map("channel_conversations")
}

/// A normalized inbound event, written only by the webhook (A5a).
model ChannelInboundEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  connectionId    String    @map("connection_id") @db.Uuid
  conversationId  String?   @map("conversation_id") @db.Uuid
  externalId      String    @map("external_id")
  contractVersion Int       @map("contract_version")
  kind            String
  sender          String
  scope           String
  payload         Json
  status          String
  occurredAt      DateTime? @map("occurred_at") @db.Timestamptz()
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz()

  @@unique([connectionId, externalId])
  @@map("channel_inbound_events")
}

/// Each part of an answer sent to a provider (A5b), once per (run, part).
model ChannelDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  executionId    String    @map("execution_id") @db.Uuid
  part           Int
  content        String
  status         String    @default("pending")
  externalId     String?   @map("external_id")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  sentAt         DateTime? @map("sent_at") @db.Timestamptz()

  @@unique([executionId, part])
  @@map("channel_deliveries")
}

/// Optional IP allow list of an area (CF5a): /platform (no partner) or the
/// /admin of a partner. The addresses are `cidr[]`, read and written by raw
/// SQL (`src/core/security/ip-allowlist.ts`).
model IpAllowlist {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area      String
  partnerId String?               @map("partner_id") @db.Uuid
  entries   Unsupported("cidr[]")
  updatedBy String                @map("updated_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime              @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("ip_allowlists")
}

/// Maintenance or read-only window of the whole platform (CF5c): one row.
model PlatformMaintenance {
  id          Boolean   @id @default(true)
  enabled     Boolean   @default(false)
  mode        String    @default("maintenance")
  startsAt    DateTime? @map("starts_at") @db.Timestamptz()
  endsAt      DateTime? @map("ends_at") @db.Timestamptz()
  messagePtBr String?   @map("message_pt_br")
  messageEn   String?   @map("message_en")
  messageEs   String?   @map("message_es")
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("platform_maintenance")
}

/// Service mode of a company (GB1a, ADR 0020): `padrao` or `gerenciado` and
/// the partner that manages it. No row means `padrao`.
model OrganizationServiceMode {
  organizationId String   @id @map("organization_id") @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  mode           String
  setBy          String?  @map("set_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([partnerId, mode])
  @@map("organization_service_modes")
}

/// Google ficha linked to a unit of the workspace (GB1a).
model GbLocation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  unitId           String?   @unique @map("unit_id") @db.Uuid
  provider         String
  externalId       String    @map("external_id")
  accountRef       String?   @map("account_ref")
  placeId          String?   @map("place_id")
  name             String
  connectionStatus String    @default("connected") @map("connection_status")
  onboardingStatus String    @default("reading") @map("onboarding_status")
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([id, workspaceId])
  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, createdAt])
  @@map("gb_locations")
}

/// Version of a ficha (GB1a): the initial one is the base of the defense.
model GbSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gbLocationId   String   @map("gb_location_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  kind           String
  data           Json
  reviews        Json     @default("[]")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([gbLocationId, createdAt(sort: Desc)])
  @@map("gb_snapshots")
}

/// Result of one analysis of the registry for a ficha (GB1a and GB1b).
model GbAnalysisRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gbLocationId   String    @map("gb_location_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  analysisKey    String    @map("analysis_key")
  area           String
  phase          String
  status         String    @default("pending")
  findings       Json      @default("[]")
  metrics        Json      @default("{}")
  error          String?
  startedAt      DateTime? @map("started_at") @db.Timestamptz()
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz()
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([gbLocationId, analysisKey])
  @@map("gb_analysis_runs")
}

/// Ficha level of the agent settings and approval of each area (GB1a).
model GbAreaSetting {
  gbLocationId   String    @map("gb_location_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  area           String
  enabled        Boolean
  autonomy       String
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz()
  approvedBy     String?   @map("approved_by") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@id([gbLocationId, area])
  @@map("gb_area_settings")
}

/// Matrix account of a person (IN3, ADR 0023): opaque localpart, no secret.
model MatrixAccount {
  profileId     String    @id @map("profile_id") @db.Uuid
  localpart     String    @unique
  mxid          String    @unique
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz()

  @@map("matrix_accounts")
}

/// A conversation room of a workspace, with the mirrored conversation state (IN3).
model MatrixRoom {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  roomId                String?   @unique @map("room_id")
  origin                String
  state                 String    @default("creating")
  status                String    @default("pending")
  assignee              String?
  statusEventId         String?   @map("status_event_id")
  statusEventTs         BigInt?   @map("status_event_ts")
  consumerMxid          String?   @map("consumer_mxid")
  consumerName          String?   @map("consumer_name")
  lastConsumerMessageAt DateTime? @map("last_consumer_message_at") @db.Timestamptz()
  lastTeamMessageAt     DateTime? @map("last_team_message_at") @db.Timestamptz()
  lastAgentMessageAt    DateTime? @map("last_agent_message_at") @db.Timestamptz()
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  closedAt              DateTime? @map("closed_at") @db.Timestamptz()

  @@unique([id, workspaceId])
  @@map("matrix_rooms")
}

/// Membership of a room, followed from the Application Service (IN3).
model MatrixRoomMember {
  roomId         String   @map("room_id")
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  userMxid       String   @map("user_mxid")
  membership     String
  eventTs        BigInt?  @map("event_ts")
  power          Int?     @db.SmallInt
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@id([roomId, userMxid])
  @@map("matrix_room_members")
}

/// A person marked as attendant of a workspace's Inbox (IN4a).
model InboxAttendant {
  workspaceId    String   @map("workspace_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([workspaceId, userId])
  @@map("inbox_attendants")
}

/// The address of a workspace on the chat, a user of the namespace (IN4a).
model MatrixWorkspaceAddress {
  workspaceId    String   @id @map("workspace_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  localpart      String   @unique
  mxid           String   @unique
  state          String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("matrix_workspace_addresses")
}

/// Label catalog of a workspace's Inbox (IN4b).
model InboxLabel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
