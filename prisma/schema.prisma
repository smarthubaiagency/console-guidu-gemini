  @@index([workspaceId, locationId, status])
  @@map("gb_maps_competitors")
}

/// One measurement of the map of a unit (GB1b); the first is the starting
/// point. Append-only.
model GbMapsScan {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  locationId         String   @map("location_id") @db.Uuid
  isBaseline         Boolean  @default(false) @map("is_baseline")
  gridSize           Int      @map("grid_size") @db.SmallInt
  radiusM            Int      @map("radius_m")
  keywordCount       Int      @map("keyword_count") @db.SmallInt
  score              Int?     @db.SmallInt
  scoreBreakdown     Json     @default("[]") @map("score_breakdown")
  reviewStats        Json     @default("{}") @map("review_stats")
  provider           String
  apiCalls           Int      @default(0) @map("api_calls")
  costEstimateMicros BigInt   @default(0) @map("cost_estimate_micros")
