  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  scanId         String   @map("scan_id") @db.Uuid
  keywordId      String   @map("keyword_id") @db.Uuid
  keyword        String
  ranks          Json
  solv           Decimal  @db.Decimal(5, 2)
  averageRank    Decimal? @map("average_rank") @db.Decimal(5, 2)
  foundPoints    Int      @map("found_points") @db.SmallInt
  totalPoints    Int      @map("total_points") @db.SmallInt
  competitors    Json     @default("[]")
  neighborhoods  Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  scan GbMapsScan @relation(fields: [scanId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([scanId, keywordId])
  @@index([workspaceId, scanId])
  @@map("gb_maps_scan_results")
}

/// Item of the Portfolio module (F5a): UCP product fields, internal
