generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Platform-side projection of a Supabase Auth identity. `status` is the
/// server-side revocation switch: anything other than `active` stops the
/// identity from writing its own row, even with a still-valid JWT.
/// SMA-98 adds the remaining auth-slice columns on top of this model.
model Profile {
  id                  String         @id @db.Uuid
  fullName            String?        @map("full_name")
  preferences         Json           @default("{}")
  status              String         @default("active")
  statusReason        String?        @map("status_reason")
  statusChangedAt     DateTime       @default(now()) @map("status_changed_at") @db.Timestamptz()
  lastSignInAt        DateTime?      @map("last_sign_in_at") @db.Timestamptz()
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  sentInvitations     Invitation[]   @relation("InvitationsSent")
  acceptedInvitations Invitation[]   @relation("InvitationsAccepted")
  apiKeys             ApiKey[]
  agentSessions       AgentSession[]

  @@map("profiles")
}

/// Partner level above organizations (ADR 0012). The house partner
/// (`isHouse`) serves direct customers. Read-only for the application and
/// scoped by RLS to `app.partner_id`.
model Partner {
  id              String                     @id @db.Uuid
  slug            String                     @unique
  name            String
  status          String                     @default("active")
  isHouse         Boolean                    @default(false) @map("is_house")
  checkoutEnabled Boolean                    @default(false) @map("checkout_enabled")
  checkoutBlocked Boolean                    @default(false) @map("checkout_blocked")
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()
  domains         PartnerDomain[]
  organizations   Organization[]
  brands          PartnerBrand[]
  members         PartnerMember[]
  invitations     PartnerInvitation[]
  offeredModules  PartnerOfferedModule[]
  templates       PartnerWorkspaceTemplate[]
  legalDocuments  PartnerLegalDocument[]
  supportGrants   PartnerSupportGrant[]
  partnerPlans    PartnerPlan[]
  billingProfile  PartnerBillingProfile?
  splitRules      SplitRule[]
  subscriptions   Subscription[]
  payments        Payment[]
  providerEvents  PaymentProviderEvent[]

  @@map("partners")
}

/// Job run: transactional outbox of the web runtime and projection of the
/// Executions page (F3a). The worker mirrors pg-boss state here.
model JobRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           String
  scope          String    @default("workspace")
  partnerId      String?   @map("partner_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  requestedBy    String?   @map("requested_by") @db.Uuid
  payload        Json      @default("{}")
  idempotencyKey String    @map("idempotency_key")
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after") @db.Timestamptz()
  lastError      String?   @map("last_error")
  result         Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz()
  startedAt      DateTime? @map("started_at") @db.Timestamptz()
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([kind, idempotencyKey])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("job_runs")
}

/// Provisional billing terms of decision 4 of the F3 plan (single row, F3c).
model BillingSettings {
  id               Int      @id @default(1) @db.SmallInt
  pastDueAfterDays Int      @default(3) @map("past_due_after_days")
  suspendAfterDays Int      @default(7) @map("suspend_after_days")
  provisional      Boolean  @default(true)
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("billing_settings")
}

/// Notice sent (or skipped) through the notification port (F3c).
model NotificationDelivery {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  eventType      String   @map("event_type")
  recipientEmail String   @map("recipient_email")
  subject        String
  idempotencyKey String   @unique @map("idempotency_key")
  relatedId      String?  @map("related_id") @db.Uuid
  status         String   @default("pending")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([partnerId, createdAt(sort: Desc)])
  @@map("notification_deliveries")
}

/// Monthly payout totals per partner, generated by a job (F3c).
model PayoutReport {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId        String   @map("partner_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  paymentsCount    Int      @map("payments_count")
  receivedCents    Int      @map("received_cents")
  refundedCents    Int      @map("refunded_cents")
  platformNetCents Int      @map("platform_net_cents")
  partnerNetCents  Int      @map("partner_net_cents")
  generatedAt      DateTime @default(now()) @map("generated_at") @db.Timestamptz()

  @@unique([partnerId, periodStart])
  @@map("payout_reports")
}

/// Base plan of the platform (P5m). Values live in insert-only versions.
model Plan {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String        @unique
  name      String
  status    String        @default("active")
  createdBy String?       @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  versions  PlanVersion[]

  @@map("plans")
}

/// Insert-only plan version: floor, minimum platform share and partner base
/// value in cents, interval and included modules (P5m).
model PlanVersion {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId                String         @map("plan_id") @db.Uuid
  version               Int
  billingInterval       String         @default("monthly") @map("billing_interval")
  moduleKeys            String[]       @default([]) @map("module_keys")
  minPriceCents         Int            @map("min_price_cents")
  minPlatformShareCents Int            @map("min_platform_share_cents")
  partnerBasePriceCents Int            @map("partner_base_price_cents")
  provisional           Boolean        @default(false)
  /// Quota limits of this version, `{ "<key>": n }` (F3b).
  limits                Json           @default("{}")
  createdBy             String?        @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  plan                  Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  partnerPlans          PartnerPlan[]
  subscriptions         Subscription[]

  @@unique([planId, version])
  @@index([planId])
  @@map("plan_versions")
}

/// Platform percentage in basis points, insert-only; no partner = default.
model SplitRule {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId         String?        @map("partner_id") @db.Uuid
  version           Int
  platformPercentBp Int            @map("platform_percent_bp")
  createdBy         String?        @map("created_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  partner           Partner?       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  subscriptions     Subscription[]

  @@unique([partnerId, version])
  @@map("split_rules")
}

/// Partner price over a plan version (customer pays mode, P5m).
model PartnerPlan {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId     String         @map("partner_id") @db.Uuid
  planVersionId String         @map("plan_version_id") @db.Uuid
  name          String
  priceCents    Int            @map("price_cents")
  status        String         @default("active")
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([partnerId, name])
  @@index([partnerId])
  @@map("partner_plans")
}

/// The partner as payer and its provider (manual until P6).
model PartnerBillingProfile {
  partnerId    String   @id @map("partner_id") @db.Uuid
  legalName    String   @map("legal_name")
  taxId        String   @map("tax_id")
  billingEmail String   @map("billing_email")
  provider     String   @default("manual")
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_billing_profiles")
}

/// Subscription of a company; terms frozen at creation (P5m).
model Subscription {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId          String       @map("partner_id") @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  planVersionId      String       @map("plan_version_id") @db.Uuid
  partnerPlanId      String?      @map("partner_plan_id") @db.Uuid
  splitRuleId        String?      @map("split_rule_id") @db.Uuid
  mode               String
  payer              String
  provider           String       @default("manual")
  billingInterval    String       @map("billing_interval")
  amountCents        Int          @map("amount_cents")
  status             String       @default("pending")
  currentPeriodStart DateTime?    @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime?    @map("current_period_end") @db.Date
  canceledAt         DateTime?    @map("canceled_at") @db.Timestamptz()
  createdBy          String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  partner            Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  planVersion        PlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  partnerPlan        PartnerPlan? @relation(fields: [partnerPlanId], references: [id], onDelete: Restrict)
  splitRule          SplitRule?   @relation(fields: [splitRuleId], references: [id], onDelete: Restrict)

  @@unique([id, partnerId, organizationId])
  @@index([partnerId])
  @@map("subscriptions")
}

/// Normalized provider event, unique per provider and external id (P5m).
model PaymentProviderEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  externalId  String    @map("external_id")
  eventType   String    @map("event_type")
  partnerId   String    @map("partner_id") @db.Uuid
  payload     Json      @default("{}")
  status      String    @default("received")
  recordedBy  String?   @map("recorded_by") @db.Uuid
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  processedAt DateTime? @map("processed_at") @db.Timestamptz()
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payment     Payment?

  @@unique([provider, externalId])
  @@index([partnerId])
  @@map("payment_provider_events")
}

/// Insert-only payment or refund, with the computed shares (P5m).
model Payment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId          String               @map("partner_id") @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  subscriptionId     String               @map("subscription_id") @db.Uuid
  kind               String               @default("payment")
  refundOf           String?              @unique @map("refund_of") @db.Uuid
  provider           String
  providerEventId    String               @unique @map("provider_event_id") @db.Uuid
  method             String
  amountCents        Int                  @map("amount_cents")
  platformShareCents Int                  @map("platform_share_cents")
  partnerShareCents  Int                  @map("partner_share_cents")
  periodStart        DateTime?            @map("period_start") @db.Date
  periodEnd          DateTime?            @map("period_end") @db.Date
  paidOn             DateTime             @map("paid_on") @db.Date
  note               String?
  evidence           Bytes?
  evidenceMime       String?              @map("evidence_mime")
  recordedBy         String?              @map("recorded_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  partner            Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  providerEvent      PaymentProviderEvent @relation(fields: [providerEventId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([subscriptionId])
  @@map("payments")
}

/// Terms and privacy policy of a partner, versioned and insert-only (P4b2).
model PartnerLegalDocument {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId          String            @map("partner_id") @db.Uuid
  kind               String
  version            Int
  title              String
  body               String
  requiresAcceptance Boolean           @default(true) @map("requires_acceptance")
  publishedBy        String?           @map("published_by") @db.Uuid
  publishedAt        DateTime          @default(now()) @map("published_at") @db.Timestamptz()
  partner            Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  acceptances        LegalAcceptance[]

  @@unique([partnerId, kind, version])
  @@map("partner_legal_documents")
}

/// Acceptance of one legal document version by one user (P4b2).
model LegalAcceptance {
  userId     String               @map("user_id") @db.Uuid
  documentId String               @map("document_id") @db.Uuid
  acceptedAt DateTime             @default(now()) @map("accepted_at") @db.Timestamptz()
  document   PartnerLegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([userId, documentId])
  @@map("legal_acceptances")
}

/// Temporary support access of a partner member to a customer (P4b2).
model PartnerSupportGrant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId      String    @map("partner_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  workspaceSlug  String?   @map("workspace_slug")
  granteeUserId  String    @map("grantee_user_id") @db.Uuid
  granteeEmail   String    @map("grantee_email")
  requestedBy    String    @map("requested_by") @db.Uuid
  reason         String
  durationHours  Int       @map("duration_hours")
  status         String    @default("pending")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz()
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  partner        Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([organizationId])
  @@index([granteeUserId])
  @@map("partner_support_grants")
}

/// Modules a partner offers to its customers (P4b).
model PartnerOfferedModule {
  partnerId String   @map("partner_id") @db.Uuid
  moduleKey String   @map("module_key")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([partnerId, moduleKey])
  @@map("partner_offered_modules")
}

/// Named set of offered modules applied to a new customer's workspace (P4b).
model PartnerWorkspaceTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  name       String
  moduleKeys String[] @default([]) @map("module_keys")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, name])
  @@map("partner_workspace_templates")
}

/// Partner roles (D-PA-02). Grant no access to workspace data.
model PartnerMember {
  partnerId String   @map("partner_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  email     String
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([partnerId, userId])
  @@index([userId])
  @@map("partner_members")
}

/// Invitation to join a partner; the token is stored only as a hash.
model PartnerInvitation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  email      String
  role       String
  tokenHash  String   @unique @map("token_hash")
  status     String   @default("pending")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  invitedBy  String?  @map("invited_by") @db.Uuid
  acceptedBy String?  @map("accepted_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_invitations")
}

/// Versioned partner brand (ADR 0012, P3). Insert-only; the highest version
/// is active. A partner without rows uses the environment brand (ADR 0004).
model PartnerBrand {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  version      Int
  displayName  String   @map("display_name")
  primaryColor String?  @map("primary_color")
  supportEmail String?  @map("support_email")
  supportUrl   String?  @map("support_url")
  logo         Bytes?
  logoMime     String?  @map("logo_mime")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, version])
  @@map("partner_brands")
}

/// Partner hosts (subdomain or custom). Platform hosts come from the
/// environment and always resolve to the house partner.
model PartnerDomain {
  host      String   @id
  partnerId String   @map("partner_id") @db.Uuid
  kind      String
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_domains")
}

model Organization {
  id          String               @id @db.Uuid
  name        String
  status      String               @default("active")
  maxSeats    Int                  @default(5) @map("max_seats")
  /// Never written by the application (trigger in the P2 migration).
  partnerId   String               @default("00000000-0000-4000-8000-000000000000") @map("partner_id") @db.Uuid
  partner     Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  members     OrganizationMember[]
  workspaces  Workspace[]
  invitations Invitation[]
  auditEvents AuditEvent[]

  @@index([partnerId])
  @@map("organizations")
}

model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_members")
}

model Workspace {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  slug           String             @unique
  name           String
  status         String             @default("active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  invitations    Invitation[]
  credentials    Credential[]
  apiKeys        ApiKey[]
  agentConfigs   AgentConfig[]
  agentSessions  AgentSession[]
  agentMessages  AgentMessage[]
  auditEvents    AuditEvent[]
  modules        WorkspaceModule[]
  helloRecords   HelloWorldRecord[]

  @@unique([id, organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId    String    @map("workspace_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String
  status         String    @default("active")
  /// Temporary support membership (P4b2): valid only while the grant is
  /// approved and unexpired; the SQL membership helpers enforce it.
  supportGrantId String?   @map("support_grant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  workspace      Workspace @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model Invitation {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  workspaceId      String?      @map("workspace_id") @db.Uuid
  email            String
  role             String
  tokenHash        String       @unique @map("token_hash")
  invitedByUserId  String       @map("invited_by_user_id") @db.Uuid
  status           String       @default("pending")
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz()
  acceptedAt       DateTime?    @map("accepted_at") @db.Timestamptz()
  acceptedByUserId String?      @map("accepted_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        Workspace?   @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  invitedBy        Profile      @relation("InvitationsSent", fields: [invitedByUserId], references: [id])
  acceptedBy       Profile?     @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id])

  @@map("invitations")
}

model PlatformAdminMember {
  userId    String   @id @map("user_id") @db.Uuid
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_admin_members")
}

model Credential {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  provider         String
  purpose          String    @default("all")
  label            String
  maskedValue      String    @map("masked_value")
  encryptedPayload String    @map("encrypted_payload")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  workspace        Workspace @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@map("credentials")
}

model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  prefix         String
  keyHash        String    @unique @map("key_hash")
  scopes         String[]  @default(["workspace:read", "modules:read"])
  status         String    @default("active")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz()
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  workspace      Workspace @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user           Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AgentConfig {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  name             String
  description      String?
  systemPrompt     String         @map("system_prompt")
  primaryProvider  String         @map("primary_provider")
  primaryModel     String         @map("primary_model")
  fallbackProvider String?        @map("fallback_provider")
  fallbackModel    String?        @map("fallback_model")
  temperature      Decimal        @default(0.70) @db.Decimal(3, 2)
  status           String         @default("active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  workspace        Workspace      @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sessions         AgentSession[]

  @@map("agent_configs")
}

model AgentSession {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  agentConfigId   String?        @map("agent_config_id") @db.Uuid
  title           String         @default("Nova Conversa")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  status          String         @default("active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  workspace       Workspace      @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  agentConfig     AgentConfig?   @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  createdByUser   Profile        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  messages        AgentMessage[]

  @@map("agent_sessions")
}

model AgentMessage {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  sessionId         String       @map("session_id") @db.Uuid
  role              String
  content           String
  providerUsed      String       @map("provider_used")
  modelUsed         String       @map("model_used")
  fallbackTriggered Boolean      @default(false) @map("fallback_triggered")
  latencyMs         Int          @default(0) @map("latency_ms")
  tokensEstimated   Int          @default(0) @map("tokens_estimated")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  workspace         Workspace    @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  session           AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

model AuditEvent {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt         DateTime      @default(now()) @map("occurred_at") @db.Timestamptz()
  organizationId     String?       @map("organization_id") @db.Uuid
  workspaceId        String?       @map("workspace_id") @db.Uuid
  actorUserId        String?       @map("actor_user_id") @db.Uuid
  actorPrincipalType String        @map("actor_principal_type")
  representedUserId  String?       @map("represented_user_id") @db.Uuid
  origin             String
  clientId           String?       @map("client_id")
  grantId            String?       @map("grant_id") @db.Uuid
  action             String
  resourceType       String        @map("resource_type")
  resourceId         String?       @map("resource_id")
  result             String
  requestId          String?       @map("request_id")
  metadata           Json          @default("{}")
  organization       Organization? @relation(fields: [organizationId], references: [id])
  workspace          Workspace?    @relation(fields: [workspaceId, organizationId], references: [id, organizationId])

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

/// Global module state written only by platform owner/operations (ADR 0005).
/// A missing row means availability "enabled" with an empty config.
model PlatformModule {
  moduleKey    String   @id @map("module_key")
  availability String   @default("enabled")
  config       Json     @default("{}")
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_modules")
}

/// Per-workspace module enablement and configuration (Especificação §6).
model WorkspaceModule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  moduleKey      String    @map("module_key")
  status         String    @default("disabled")
  config         Json      @default("{}")
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  workspace      Workspace @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([workspaceId, moduleKey])
  @@index([workspaceId, organizationId])
  @@map("workspace_modules")
}

/// Demonstration data of the reference module (Adendo §9); never seeded.
model HelloWorldRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  title          String
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  workspace      Workspace @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([workspaceId, organizationId, createdAt(sort: Desc)])
  @@map("hello_world_records")
}
