# Desenvolvimento: exclusivamente o projeto Supabase console-guidu (ref ssulunrysnvwyqjlkpry, sa-east-1), conforme ADR 0010 e ADR 0008.
# O projeto guidu (mmwmhlafzewdyqsgfkzk) e produção são estritamente proibidos neste repositório.
# Nunca adicione URLs, chaves ou credenciais reais ao repositório.

# Configuração de marca e domínio (ADR 0004).
# Em desenvolvimento e teste, valores padrão são "GUIDU" e "http://localhost:3000".
# Em produção (NODE_ENV=production), ambas as variáveis são estritamente obrigatórias (erro explícito, sem fallback).
APP_NAME="GUIDU"
APP_URL="http://localhost:3000"

# Hosts adicionais da plataforma, separados por vírgula (ADR 0012). O host de APP_URL já é
# da plataforma e, fora de produção, localhost e 127.0.0.1 também. Esses hosts servem o
# parceiro zero e /platform; qualquer outro host precisa ser domínio ativo de um parceiro.
PLATFORM_HOSTS=""

# Domínio-base dos subdomínios de parceiro (<parceiro>.<base>), por exemplo "guidu.com.br".
# Fora de produção o padrão é "localhost" (agencia.localhost); em produção, sem valor, não há subdomínios.
PARTNER_SUBDOMAIN_BASE=""

# Domínios personalizados (CF2b): painel do parceiro e domínios públicos dos workspaces.
# Destino do CNAME que todo domínio personalizado aponta (o proxy), por exemplo "proxy.guidu.com.br".
# Sem valor, os domínios são cadastrados mas não verificados.
CUSTOM_DOMAIN_CNAME_TARGET=""
# Cloudflare for SaaS: emite o certificado de cada domínio (custom hostname, DV por HTTP).
# Sem token e zona, o proxy emite o certificado e o DNS sozinho ativa o domínio.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
# Segredo compartilhado do ForwardAuth do Traefik (/api/domains/check, cabeçalho X-Check-Secret).
# No mínimo 16 caracteres; sem ele a verificação nega todo host (fail-closed).
DOMAINS_CHECK_SECRET=""

# Domínios públicos padrão (CF2c, docs/operacao/dominios-publicos.md): cada workspace responde em
# {slug}.{domínio do tipo}. Sem a variável valem mobio.pro, quiz.mobio.pro e mobio.page;
# com valor vazio o tipo fica desligado (por isso ficam comentadas aqui).
# PUBLIC_DOMAIN_PROFILE="mobio.pro"
# PUBLIC_DOMAIN_QUIZ="quiz.mobio.pro"
# PUBLIC_DOMAIN_PAGE="mobio.page"

# E-mail pelo Resend (CF3a, D-PA-08). Sem os dois, o envio fica desligado e os avisos só são registrados.
RESEND_API_KEY=""
# Endereço de envio de um domínio verificado no Resend (ex.: avisos@guidu.com.br).
EMAIL_FROM_ADDRESS=""

# Pooler transacional de desenvolvimento (porta 6543); pgbouncer=true e connection_limit=1 são obrigatórios (ADR 0001).
DATABASE_URL="postgresql://app_runtime.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Conexão de sessão via pooler (porta 5432), usada para tarefas diretas sem transação pgbouncer (ADR 0001).
DIRECT_DATABASE_URL="postgresql://app_runtime.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Somente para scripts/migrate.ts; nunca no runtime. Conecta como papel privilegiado app_migrations.
MIGRATION_DATABASE_URL="postgresql://app_migrations.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Somente para o processo worker (pnpm worker, ADR 0002, F3a). Conecta como app_worker pelo pooler de sessão
# (porta 5432); o pg-boss usa polling. O web nunca usa esta URL.
WORKER_DATABASE_URL="postgresql://app_worker.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Jobs simultâneos por processo worker (padrão 4). Um workspace nunca tem dois jobs ao mesmo tempo.
WORKER_CONCURRENCY="4"
# Nome da instância no heartbeat e em /platform/operations (padrão: nome do host). F3d.
WORKER_INSTANCE_NAME=""
# Porta das probes do worker (/health/live e /health/ready); vazio desliga. F3d.
WORKER_HEALTH_PORT=""
# Versão publicada no heartbeat (ex.: o SHA do deploy); opcional. F3d.
GUIDU_VERSION=""

# Tradução automática (I6): textos do painel e documentos legais, com Claude (API da Anthropic).
# Leia nos dois processos (web e worker): o web só verifica se existe para habilitar os botões;
# o worker usa a chave ao rodar os jobs. Nunca é registrada em log, gravada ou enviada ao navegador.
# Sem chave, os botões ficam desabilitados ("Provedor de tradução não configurado").
TRANSLATION_ANTHROPIC_API_KEY=""
# "fake" usa o tradutor determinístico de testes e e2e (nenhuma chamada externa); vazio usa a chave acima.
TRANSLATION_PROVIDER=""

# Redis (F4a): limite de requisições da API e do MCP, e futuramente as automações. Sem ele o limite é
# contado no Postgres. No dev e em produção, aponte para o Redis do Coolify (com senha; TLS se exposto).
REDIS_URL=""
# Limites provisórios por minuto (plano F4, decisão 1).
API_RATE_LIMIT_PER_KEY="60"
API_RATE_LIMIT_PER_USER="120"
API_RATE_LIMIT_PER_WORKSPACE="300"

# Chave mestra de criptografia (AES-256-GCM) para o cofre de credenciais BYOK (§16).
# Exatamente 32 bytes em 64 caracteres hexadecimais (gere com: openssl rand -hex 32) ou 44 base64.
# Estritamente obrigatória em todos os ambientes (erro explícito, sem fallback inseguro).
ENCRYPTION_KEY="<64 caracteres hex — gere com: openssl rand -hex 32>"
ENCRYPTION_KEY_ID="k1"
# ENCRYPTION_KEYS_PREVIOUS="k0:<chave_hex>,kold:<chave_hex>" # Chaves anteriores para rotação (somente leitura/decifração)

# Selo da Central de Eventos (H1, ADR 0022): HMAC-SHA256 de cada evento.
# Web e worker; sem ela a emissão de eventos falha (erro explícito).
# Pelo menos 32 caracteres (gere com: openssl rand -hex 32); o id vai em `key_version`.
EVENTS_HMAC_KEY="<64 caracteres hex — gere com: openssl rand -hex 32>"
EVENTS_HMAC_KEY_ID="k1"
# EVENTS_HMAC_KEYS_PREVIOUS="k0:<chave>" # Chaves anteriores, só para conferir selos antigos

# Supabase Auth e SSR (substitua com os valores de configuração do ambiente)
SUPABASE_URL="https://ssulunrysnvwyqjlkpry.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"

# Segurança (CF5a, docs/operacao/seguranca.md): proxies confiáveis que
# acrescentam ao X-Forwarded-For (1 = só Traefik; 2 = Cloudflare + Traefik)
# e chave de emergência que desliga as listas de IPs ("off").
TRUSTED_PROXY_HOPS="1"
SECURITY_IP_ALLOWLIST=""

# Autenticação (CF5b, docs/operacao/autenticacao.md): "true" só depois que a
# operação ligar o provedor no Supabase Auth. O botão também depende da
# cascata (Configurações › Autenticação).
AUTH_GOOGLE_ENABLED=""
AUTH_MAGIC_LINK_ENABLED=""

# Matrix do Inbox (IN3, ADR 0023; docs/operacao/synapse-easypanel.md). Gerados por
# `pnpm tsx scripts/matrix/setup.ts generate`; web e worker. Sem eles o Matrix fica desligado.
# MATRIX_JWT_PRIVATE_KEY: chave privada RS256 em PEM, em base64 numa linha (ou o PEM direto).
MATRIX_HOMESERVER_URL=""
MATRIX_SERVER_NAME=""
MATRIX_AS_ID=""
MATRIX_AS_SENDER=""
MATRIX_AS_TOKEN=""
MATRIX_HS_TOKEN=""
MATRIX_JWT_ISSUER=""
MATRIX_JWT_AUDIENCE=""
MATRIX_JWT_PRIVATE_KEY=""

# WhatsApp da Meta (IN7a, docs/modules/inbox/plano-in7.md). O app da GUIDU na
# Meta: o segredo assina os webhooks e troca o código do Embedded Signup; o
# verify token responde ao cadastro do webhook (https://<app>/api/channels/meta).
# Sem META_APP_ID e META_EMBEDDED_SIGNUP_CONFIG_ID o botão "Conectar com a
# Meta" fica desligado e os números são ligados manualmente.
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# Só para testes: a Graph API falsa (padrão https://graph.facebook.com/v21.0).
META_GRAPH_URL=""
