# Desenvolvimento: exclusivamente o projeto Supabase console-guidu (ref ssulunrysnvwyqjlkpry, sa-east-1), conforme ADR 0010 e ADR 0008.
# O projeto guidu (mmwmhlafzewdyqsgfkzk) e produção são estritamente proibidos neste repositório.
# Nunca adicione URLs, chaves ou credenciais reais ao repositório.

# Configuração de marca e domínio (ADR 0004).
# Em desenvolvimento e teste, valores padrão são "GUIDU" e "http://localhost:3000".
# Em produção (NODE_ENV=production), ambas as variáveis são estritamente obrigatórias (erro explícito, sem fallback).
APP_NAME="GUIDU"
APP_URL="http://localhost:3000"

# Hosts adicionais da plataforma, separados por vírgula (ADR 0012). O host de APP_URL já é
# da plataforma e, fora de produção, localhost e 127.0.0.1 também. Esses hosts servem o
# parceiro zero e /platform; qualquer outro host precisa ser domínio ativo de um parceiro.
PLATFORM_HOSTS=""

# Domínio-base dos subdomínios de parceiro (<parceiro>.<base>), por exemplo "guidu.com.br".
# Fora de produção o padrão é "localhost" (agencia.localhost); em produção, sem valor, não há subdomínios.
PARTNER_SUBDOMAIN_BASE=""

# Pooler transacional de desenvolvimento (porta 6543); pgbouncer=true e connection_limit=1 são obrigatórios (ADR 0001).
DATABASE_URL="postgresql://app_runtime.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Conexão de sessão via pooler (porta 5432), usada para tarefas diretas sem transação pgbouncer (ADR 0001).
DIRECT_DATABASE_URL="postgresql://app_runtime.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Somente para scripts/migrate.ts; nunca no runtime. Conecta como papel privilegiado app_migrations.
MIGRATION_DATABASE_URL="postgresql://app_migrations.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Somente para o processo worker (pnpm worker, ADR 0002, F3a). Conecta como app_worker pelo pooler de sessão
# (porta 5432); o pg-boss usa polling. O web nunca usa esta URL.
WORKER_DATABASE_URL="postgresql://app_worker.ssulunrysnvwyqjlkpry:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Jobs simultâneos por processo worker (padrão 4). Um workspace nunca tem dois jobs ao mesmo tempo.
WORKER_CONCURRENCY="4"
# Nome da instância no heartbeat e em /platform/operations (padrão: nome do host). F3d.
WORKER_INSTANCE_NAME=""
# Porta das probes do worker (/health/live e /health/ready); vazio desliga. F3d.
WORKER_HEALTH_PORT=""
# Versão publicada no heartbeat (ex.: o SHA do deploy); opcional. F3d.
GUIDU_VERSION=""

# Chave mestra de criptografia (AES-256-GCM) para o cofre de credenciais BYOK (§16).
# Exatamente 32 bytes em 64 caracteres hexadecimais (gere com: openssl rand -hex 32) ou 44 base64.
# Estritamente obrigatória em todos os ambientes (erro explícito, sem fallback inseguro).
ENCRYPTION_KEY="<64 caracteres hex — gere com: openssl rand -hex 32>"
ENCRYPTION_KEY_ID="k1"
# ENCRYPTION_KEYS_PREVIOUS="k0:<chave_hex>,kold:<chave_hex>" # Chaves anteriores para rotação (somente leitura/decifração)

# Supabase Auth e SSR (substitua com os valores de configuração do ambiente)
SUPABASE_URL="https://ssulunrysnvwyqjlkpry.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
